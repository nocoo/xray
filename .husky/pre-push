#!/usr/bin/env sh
# S3: L2 tests + coverage + G2 (hard fail)
set -e
cd "$(dirname "$0")/.."

echo "━━━ L2 worker tests ━━━"
bun run test:l2

echo "━━━ L1 coverage gate ━━━"
bun run test:coverage

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks required for pre-push G2" >&2
  exit 1
fi
echo "━━━ gitleaks detect (G2) ━━━"
gitleaks detect --no-banner --source . --verbose

if command -v osv-scanner >/dev/null 2>&1; then
  echo "━━━ osv-scanner (G2) ━━━"
  osv-scanner scan --lockfile=bun.lock
else
  echo "⚠ osv-scanner not installed locally — CI enforces G2 OSV"
fi
