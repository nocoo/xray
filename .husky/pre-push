#!/usr/bin/env sh
# 6DQ pre-push: L2 (real-HTTP worker e2e + route gate) ‖ G2 (gitleaks + osv)
set -e
cd "$(dirname "$0")/.."

echo "━━━ L2 real-HTTP + route coverage ━━━"
# Isolation: unset remote CF credentials so wrangler cannot touch prod
env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID -u CF_API_TOKEN \
  bun run test:l2

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ gitleaks required for pre-push G2" >&2
  exit 1
fi
echo "━━━ gitleaks detect (G2) ━━━"
gitleaks detect --no-banner --source . --verbose

if ! command -v osv-scanner >/dev/null 2>&1; then
  echo "❌ osv-scanner required for pre-push G2" >&2
  exit 1
fi
echo "━━━ osv-scanner (G2) ━━━"
osv-scanner scan --lockfile=bun.lock
