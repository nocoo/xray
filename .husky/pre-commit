#!/usr/bin/env sh
# S3: L1 + G1 + gitleaks (BD-1 hard gate starts at pre-push for L2)
set -e
cd "$(dirname "$0")/.."

echo "━━━ lint (G1) ━━━"
bun run lint

echo "━━━ typecheck (G1) ━━━"
bun run typecheck

echo "━━━ unit tests (L1) ━━━"
bun run test

if command -v gitleaks >/dev/null 2>&1; then
  echo "━━━ gitleaks ━━━"
  gitleaks protect --staged --no-banner
else
  echo "⚠ gitleaks not installed — skip"
fi
