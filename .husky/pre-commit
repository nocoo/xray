#!/usr/bin/env sh
# 6DQ pre-commit: G1 (lint + typecheck) + L1 (unit + coverage)
set -e
cd "$(dirname "$0")/.."

echo "━━━ lint (G1) ━━━"
bun run lint

echo "━━━ typecheck (G1) ━━━"
bun run typecheck

echo "━━━ L1 unit + coverage (≥95% lines/funcs/branches) ━━━"
bun run test:coverage

if command -v gitleaks >/dev/null 2>&1; then
  echo "━━━ gitleaks (staged) ━━━"
  gitleaks protect --staged --no-banner
else
  echo "⚠ gitleaks not installed — skip"
fi
