{
	"name": "@xray/worker",
	"version": "2.5.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --local --env development --port 37007 --ip 127.0.0.1 --persist-to .wrangler/state-mock",
		"build": "wrangler deploy --dry-run --outdir=dist --env production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"deploy": "wrangler deploy --env production"
	},
	"dependencies": {
		"@xray/shared": "workspace:*",
		"entities": "7.0.1",
		"hono": "4.13.8",
		"jose": "6.2.12"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260918.1",
		"@vitest/coverage-v8": "5.0.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.1",
		"wrangler": "4.135.0"
	}
}
