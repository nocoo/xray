		"deploy": "wrangler deploy --env production"
	},
	"dependencies": {
		"@xray/shared": "workspace:*",
		"hono": "4.13.5",
		"jose": "^6.2.11"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260903.1",
		"@vitest/coverage-v8": "5.0.0",
		"typescript": "^7.0.2",
		"vitest": "5.0.0",
		"wrangler": "4.129.0"
	}
}
