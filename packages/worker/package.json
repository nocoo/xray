{
	"name": "@xray/worker",
	"version": "2.1.8",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --env development --port 8787 --ip 127.0.0.1",
		"build": "wrangler deploy --dry-run --outdir=dist --env production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"deploy": "wrangler deploy --env production"
	},
	"dependencies": {
		"@xray/shared": "workspace:*",
		"hono": "4.13.3",
		"jose": "^6.2.9"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260820.1",
		"@vitest/coverage-v8": "4.1.11",
		"typescript": "^7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.124.0"
	}
}
