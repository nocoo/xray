{
	"name": "@xray/worker",
	"version": "2.2.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --env development --port 37007 --ip 127.0.0.1",
		"build": "wrangler deploy --dry-run --outdir=dist --env production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
