# Local Demo/E2E needs no environment file. Use bun run dev or bun run test:l3.
# The launcher creates isolated Wrangler configuration, public JWKS and a local KEK.
# It does not read daily .dev.vars or production credentials.

# Production Access and encryption settings are managed through Worker secrets.
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# XRAY_SECRETS_KEK=
# XRAY_SECRETS_KEY_VERSION=1
# XRAY_SECRETS_KEK_PREV=

# Authorized producers use ~/.config/xray/push.env (mode 600), never this file.
# XRAY_PUSH_TOKEN=
# XRAY_INGEST_BASE=https://xray-ingest.worker.hexly.ai
# Local producer: use ingestBase from /__local/environment for the active instance.
# XRAY_WINDOW_HOURS=24
