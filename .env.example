# X-Ray v2 local env (CF Workers + Vite).
# Runtime that matters: packages/worker/.dev.vars (wrangler).
# This file is a checklist. Copy to .env if you want shell exports.
# Do NOT put GOOGLE_CLIENT_* / NEXTAUTH_* here — those are legacy/v1 only.

# -------------------------------------------
# Worker (also baked into wrangler.toml [env.development])
# -------------------------------------------
ENVIRONMENT=development
AUTH_DEV_BYPASS=true
ALLOWED_EMAILS=dev@xray.local

# -------------------------------------------
# Secrets — put these in packages/worker/.dev.vars (chmod 600)
# Required to SAVE AI keys or zhe.to webhook. GET still works without KEK.
# 32 ASCII bytes or base64 that decodes to 32 bytes.
# -------------------------------------------
# XRAY_SECRETS_KEK=
# XRAY_SECRETS_KEY_VERSION=1
# XRAY_SECRETS_KEK_PREV=

# -------------------------------------------
# Production only (wrangler secret / Access). Local bypass ignores these.
# -------------------------------------------
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# -------------------------------------------
# Producer — ~/.config/xray/push.env (chmod 600), not this file
# -------------------------------------------
# XRAY_PUSH_TOKEN=
# XRAY_INGEST_BASE=http://127.0.0.1:8787
# XRAY_WINDOW_HOURS=24
