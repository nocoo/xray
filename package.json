{
	"name": "xray",
	"version": "2.6.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build:shared": "turbo run build --filter=@xray/shared",
		"dev": "bun run build:shared && bun scripts/envs.ts dev",
		"build": "turbo run build --filter=@xray/shared --filter=@xray/ui --filter=@xray/worker",
		"deploy": "bun run build && turbo run deploy --filter=@xray/worker",
		"typecheck": "turbo typecheck",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "turbo test",
		"prepare": "husky",
		"test:coverage": "bash scripts/check-coverage.sh 95 95 95",
		"test:l2": "bun run --filter @xray/worker test:e2e && bun run gate:routes",
		"test:l2:unit": "bun run --filter @xray/worker test",
		"check:wrangler-version": "bun run scripts/check-wrangler-version-sync.ts",
		"gate:routes": "bun run scripts/check-route-coverage.ts",
		"migrate:v1": "bun run scripts/migrate-v1-to-d1.ts",
		"refresh:watchlists": "bun run scripts/refresh-watchlists.ts",
		"release": "bun scripts/release.ts",
		"test:l3": "bun run build && bun scripts/test-l3.ts",
		"test:ai": "bun run --filter @xray/worker test src/routes/ai-zheto-dashboard.test.ts src/lib/secrets-crypto.test.ts",
		"preview": "bun run build && bun scripts/envs.ts dev --built",
		"login:prod": "cloudflared access login https://xray.hexly.ai > /dev/null",
		"env:db": "bun scripts/envs.ts",
		"capture:demo": "bun run build && bun scripts/capture-demo.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "1.63.0",
		"@vitest/coverage-v8": "5.0.3",
		"husky": "^9.1.0",
		"turbo": "2.11.5",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"workerd"
	],
	"overrides": {
		"esbuild": "0.28.1",
		"nanoid": "^3.3.18",
		"sharp": "0.35.4",
		"undici": "7.29.1"
	}
}
