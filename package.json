{
  "name": "x-ray",
  "version": "1.9.9",
  "description": "Twitter tech content monitoring system",
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 7007",
    "build": "vinext build",
    "start": "vinext start --port 7007",
    "lint": "eslint --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:api": "bun run scripts/run-e2e-api.ts",
    "test:e2e:browser": "npx playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "release": "bun run scripts/release.ts",
    "watchlist": "bun run scripts/manage-watchlist.ts",
    "xray-me": "bun run scripts/run-me-report.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "0.5.32",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.8.0",
    "husky": "^9.1.7",
    "shadcn": "4.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.24",
    "@ai-sdk/openai": "4.0.24",
    "@radix-ui/react-collapsible": "1.1.20",
    "ai": "7.0.42",
    "better-sqlite3": "13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.31",
    "ip-address": "^10.2.0",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.0"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "overrides": {
    "@vitejs/plugin-rsc": ">=0.5.29",
    "body-parser": ">=2.3.0",
    "brace-expansion": ">=5.0.8",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=4.1.1",
    "hono": ">=4.12.28",
    "@hono/node-server": ">=2.0.5",
    "sharp": ">=0.35.0",
    "ip-address": ">=10.1.1",
    "js-yaml": ">=5.2.2",
    "next": ">=16.2.11",
    "postcss": ">=8.5.18",
    "qs": ">=6.15.2",
    "react-server-dom-webpack": ">=19.2.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
