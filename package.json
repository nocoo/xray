{
	"name": "xray",
	"version": "2.0.0",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev --parallel",
		"dev:ui": "turbo run dev --filter=@xray/ui",
		"dev:worker": "turbo run dev --filter=@xray/worker",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "turbo test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"husky": "^9.1.0",
		"turbo": "2.10.9",
		"typescript": "^7.0.2",
		"vitest": "4.1.10"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"workerd"
	],
	"overrides": {
		"esbuild": "0.28.1"
	}
}
